# Database (pooled URL for serverless; use direct URL for drizzle-kit migrate in CI)
# Must be a real URL with a numeric port. Invalid: postgresql://user:pass@host:port/db (word "port" breaks parsing).
#
# Homebrew Postgres (no password on localhost): create DB first, e.g. `createdb seven` then:
# DATABASE_URL="postgresql://YOUR_MAC_USERNAME@127.0.0.1:5432/seven"
#
# Docker: DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:5432/7sveltekit"
DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:5432/7sveltekit"
DIRECT_DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:5432/7sveltekit"

# App
PUBLIC_APP_URL="http://localhost:5173"

# Lucia session (generate: openssl rand -hex 32)
SESSION_SECRET="replace-with-random-32-bytes-minimum"

# Stripe (https://dashboard.stripe.com/test/apikeys)
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."
PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_..."

# Resend (https://resend.com)
RESEND_API_KEY=""
EMAIL_FROM="Acme <onboarding@resend.dev>"

# S3-compatible storage (e.g. AWS S3, Cloudflare R2, MinIO)
S3_BUCKET="your-bucket"
S3_REGION="auto"
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_PUBLIC_BASE_URL="https://your-bucket.r2.dev"

# Optional analytics
PUBLIC_POSTHOG_KEY=""
PUBLIC_GA4_MEASUREMENT_ID=""
