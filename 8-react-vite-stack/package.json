{
  "name": "acme-platform",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently -n api,web -c blue,green \"npm run dev -w @acme/api\" \"npm run dev -w @acme/web\"",
    "build": "npm run build -w @acme/shared && npm run build -w @acme/api && npm run build -w @acme/web",
    "lint": "npm run lint --workspaces --if-present",
    "format": "prettier --write \"**/*.{ts,tsx,js,json,md,css}\"",
    "db:generate": "npm run db:generate -w @acme/api",
    "db:migrate": "npm run db:migrate -w @acme/api",
    "db:push": "npm run db:push -w @acme/api",
    "db:seed": "npm run db:seed -w @acme/api"
  },
  "devDependencies": {
    "concurrently": "^9.1.2",
    "prettier": "^3.5.3",
    "typescript": "^5.8.3"
  }
}
