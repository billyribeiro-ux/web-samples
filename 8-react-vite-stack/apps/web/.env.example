# Get a real key from https://dashboard.clerk.com/last-active?path=api-keys
# If unset, or still using a placeholder like "replace_me", the app runs in dev mode
# (no ClerkProvider) so the UI loads; sign-in and JWT-backed APIs stay disabled.
VITE_CLERK_PUBLISHABLE_KEY=pk_test_...
# Leave empty in development to use Vite proxy to the API (same origin /api).
VITE_API_URL=
VITE_POSTHOG_KEY=
VITE_GA4_ID=
