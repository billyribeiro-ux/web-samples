# Database
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/nuxt_stack?schema=public"

# Lucia session (min 32 chars in production)
SESSION_SECRET="replace-with-long-random-string"

# Stripe (https://dashboard.stripe.com/apikeys)
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
NUXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""

# Optional: Stripe Price IDs for subscription plans (Products → Prices in Stripe Dashboard).
# If set, `npx prisma db seed` attaches them to Starter/Pro plans so Checkout works.
# STRIPE_PRICE_STARTER_MONTHLY=""
# STRIPE_PRICE_STARTER_YEARLY=""
# STRIPE_PRICE_PRO_MONTHLY=""
# STRIPE_PRICE_PRO_YEARLY=""

# Email (https://resend.com)
RESEND_API_KEY=""
EMAIL_FROM="Apex <onboarding@resend.dev>"

# S3-compatible storage (optional; media presign)
S3_REGION=""
S3_BUCKET=""
S3_ACCESS_KEY=""
S3_SECRET_KEY=""
S3_PUBLIC_BASE_URL=""

# Public site URL (canonical links, emails, Stripe redirects)
NUXT_PUBLIC_SITE_URL="http://localhost:3000"
NUXT_PUBLIC_SITE_NAME="Apex Digital"

# Analytics (optional)
NUXT_PUBLIC_POSTHOG_KEY=""
NUXT_PUBLIC_POSTHOG_HOST="https://us.i.posthog.com"
NUXT_PUBLIC_GA4_ID=""
