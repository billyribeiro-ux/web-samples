# Database (root Prisma)
DATABASE_URL="postgresql://platform:platform@127.0.0.1:5434/platform?schema=public"

# API (apps/api)
PORT=3000
API_PREFIX=api/v1
WEB_ORIGIN=http://localhost:4200
PUBLIC_APP_URL=http://localhost:4200

# Auth0 (API validates JWTs)
AUTH0_ISSUER=https://YOUR_TENANT.auth0.com/
AUTH0_AUDIENCE=https://api.yourdomain.com
AUTH0_JWKS_URI=https://YOUR_TENANT.auth0.com/.well-known/jwks.json

# Stripe
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx
STRIPE_PRICE_MONTHLY=price_xxx
STRIPE_PRICE_YEARLY=price_xxx

# S3-compatible (MinIO local)
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=minio
AWS_SECRET_ACCESS_KEY=minio12345
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=platform-media
S3_PUBLIC_BASE_URL=http://localhost:9000/platform-media

# Resend
RESEND_API_KEY=re_xxx
EMAIL_FROM=noreply@yourdomain.com

# Web (apps/web) — build-time / runtime public
NG_APP_API_URL=http://localhost:3000/api/v1
NG_APP_AUTH0_DOMAIN=YOUR_TENANT.auth0.com
NG_APP_AUTH0_CLIENT_ID=xxx
NG_APP_AUTH0_AUDIENCE=https://api.yourdomain.com
NG_APP_PUBLIC_URL=http://localhost:4200
NG_APP_POSTHOG_KEY=
NG_APP_GA_MEASUREMENT_ID=
