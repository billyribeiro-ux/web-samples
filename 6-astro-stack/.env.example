# Database (see docker-compose.yml for local Postgres)
DATABASE_URL="postgresql://app:app@localhost:5432/astro_business?schema=public"

# App
PUBLIC_SITE_URL="http://localhost:4321"
NODE_ENV="development"

# Better Auth
BETTER_AUTH_SECRET="generate-a-long-random-string-min-32-chars"
BETTER_AUTH_URL="http://localhost:4321"

# Stripe (test keys)
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."
PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_..."

# Resend
RESEND_API_KEY="re_..."
EMAIL_FROM="Astro Business <onboarding@resend.dev>"

# S3-compatible (MinIO local or R2/S3)
S3_ENDPOINT="http://localhost:9000"
S3_REGION="us-east-1"
S3_BUCKET="media"
S3_ACCESS_KEY="minio"
S3_SECRET_KEY="minio12345"
S3_PUBLIC_URL="http://localhost:9000/media"

# PostHog (optional)
PUBLIC_POSTHOG_KEY=""
PUBLIC_POSTHOG_HOST="https://us.i.posthog.com"
