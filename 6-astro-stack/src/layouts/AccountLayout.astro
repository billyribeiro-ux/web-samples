---
import BaseLayout from '@/layouts/BaseLayout.astro';

interface Props {
  title: string;
}

const { title } = Astro.props;
---

<BaseLayout title={`${title} — Account`} noindex={true}>
  <div class="mx-auto flex max-w-6xl flex-col gap-10 px-4 py-12 md:flex-row">
    <aside class="md:w-56">
      <nav aria-label="Account" class="space-y-1 text-sm">
        <a href="/account" class="block rounded px-2 py-1 text-slate-300 hover:bg-slate-800 hover:text-white">Overview</a>
        <a href="/account/profile" class="block rounded px-2 py-1 text-slate-300 hover:bg-slate-800 hover:text-white">Profile</a>
        <a href="/account/subscription" class="block rounded px-2 py-1 text-slate-300 hover:bg-slate-800 hover:text-white">
          Subscription
        </a>
        <a href="/account/orders" class="block rounded px-2 py-1 text-slate-300 hover:bg-slate-800 hover:text-white">Orders</a>
        <a href="/account/favorites" class="block rounded px-2 py-1 text-slate-300 hover:bg-slate-800 hover:text-white">Favorites</a>
      </nav>
    </aside>
    <div class="min-w-0 flex-1">
      <h1 class="text-2xl font-semibold text-white">{title}</h1>
      <div class="mt-8">
        <slot />
      </div>
    </div>
  </div>
</BaseLayout>
