---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { prisma } from '@/lib/prisma';

const page = Number(Astro.url.searchParams.get('page') ?? '1');
const pageSize = 10;
const posts = await prisma.post.findMany({
  where: { status: 'PUBLISHED' },
  orderBy: { publishedAt: 'desc' },
  skip: (page - 1) * pageSize,
  take: pageSize,
  include: { author: true },
});
---

<BaseLayout title="Blog — Astro Business" description="Articles on product, growth, and craft.">
  <div class="mx-auto max-w-3xl px-4 py-16">
    <h1 class="text-3xl font-semibold text-white">Blog</h1>
    <ul class="mt-8 space-y-8">
      {posts.map((p) => (
        <li>
          <a href={`/blog/${p.slug}`} class="text-xl font-medium text-white hover:text-emerald-400">
            {p.title}
          </a>
          {p.excerpt && <p class="mt-2 text-sm text-slate-400">{p.excerpt}</p>}
          <p class="mt-1 text-xs text-slate-500">
            {p.publishedAt?.toISOString().slice(0, 10)} · {p.readingMinutes} min read
          </p>
        </li>
      ))}
    </ul>
  </div>
</BaseLayout>
