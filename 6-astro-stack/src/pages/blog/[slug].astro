---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { prisma } from '@/lib/prisma';

const { slug } = Astro.params;
if (!slug) throw new Error('Missing slug');

const post = await prisma.post.findFirst({
  where: { slug, status: 'PUBLISHED' },
  include: {
    author: true,
    categories: { include: { category: true } },
    tags: { include: { tag: true } },
  },
});

if (!post) {
  return Astro.redirect('/404');
}
---

<BaseLayout
  title={`${post.title} — Blog`}
  description={post.seoDescription ?? post.excerpt ?? post.title}
  canonicalPath={`/blog/${post.slug}`}
  jsonLd="article"
  jsonLdArticle={{
    title: post.title,
    description: post.seoDescription ?? undefined,
    datePublished: post.publishedAt?.toISOString(),
  }}
>
  <article class="mx-auto max-w-3xl px-4 py-16">
    <header>
      <p class="text-xs uppercase tracking-widest text-emerald-400/90">Article</p>
      <h1 class="mt-2 text-4xl font-semibold tracking-tight text-white">{post.title}</h1>
      <p class="mt-3 text-sm text-slate-500">
        {post.author?.name} · {post.readingMinutes} min read
      </p>
    </header>
    <div class="mt-10 space-y-4 text-slate-300 [&_h2]:mt-8 [&_h2]:text-xl [&_h2]:font-semibold [&_p]:leading-relaxed" set:html={post.body} />
    <footer class="mt-12 flex flex-wrap gap-2 border-t border-slate-800 pt-8">
      {post.categories.map((c) => (
        <a class="rounded-full bg-slate-800 px-3 py-1 text-xs text-slate-300" href={`/category/${c.category.slug}`}>
          {c.category.name}
        </a>
      ))}
      {post.tags.map((t) => (
        <a class="rounded-full border border-slate-700 px-3 py-1 text-xs text-slate-400" href={`/tag/${t.tag.slug}`}>
          #{t.tag.name}
        </a>
      ))}
    </footer>
  </article>
</BaseLayout>
