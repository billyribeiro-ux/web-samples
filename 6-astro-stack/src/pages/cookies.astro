---
import BaseLayout from '@/layouts/BaseLayout.astro';
---

<BaseLayout title="Cookie Policy — Astro Business">
  <div class="mx-auto max-w-3xl px-4 py-16">
    <h1 class="text-3xl font-semibold text-white">Cookie Policy</h1>
    <p class="mt-4 text-slate-400">
      We use essential cookies for sessions and cart. Optional analytics load only when `PUBLIC_POSTHOG_KEY` is set.
    </p>
  </div>
</BaseLayout>
