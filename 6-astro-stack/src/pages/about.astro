---
import BaseLayout from '@/layouts/BaseLayout.astro';
---

<BaseLayout title="About — Astro Business" description="Why we built this platform and how it is structured.">
  <div class="mx-auto max-w-3xl px-4 py-16">
    <h1 class="text-3xl font-semibold text-white">About</h1>
    <p class="mt-4 text-slate-400">
      Astro Business is a reference implementation: public marketing, CMS-backed pages, memberships, Stripe, and Postgres search
      — aligned with a serious digital business, not a toy demo.
    </p>
  </div>
</BaseLayout>
