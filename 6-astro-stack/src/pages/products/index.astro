---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { prisma } from '@/lib/prisma';

const products = await prisma.product.findMany({
  where: { isActive: true },
  orderBy: { updatedAt: 'desc' },
});
---

<BaseLayout title="Products — Astro Business" description="Digital goods and services.">
  <div class="mx-auto max-w-5xl px-4 py-16">
    <h1 class="text-3xl font-semibold text-white">Products</h1>
    <div class="mt-10 grid gap-6 sm:grid-cols-2">
      {products.map((p) => (
        <a
          href={`/products/${p.slug}`}
          class="rounded-2xl border border-slate-800 bg-slate-900/50 p-6 transition hover:border-emerald-500/40"
        >
          <h2 class="text-lg font-semibold text-white">{p.name}</h2>
          <p class="mt-2 line-clamp-3 text-sm text-slate-400">{p.description}</p>
          <p class="mt-4 text-xl font-bold text-white">${(p.price / 100).toFixed(2)}</p>
        </a>
      ))}
    </div>
  </div>
</BaseLayout>
