---
import BaseLayout from '@/layouts/BaseLayout.astro';
---

<BaseLayout title="Reset password" noindex={true}>
  <div class="mx-auto max-w-xl px-4 py-16 text-center">
    <h1 class="text-3xl font-semibold text-white">Reset password</h1>
    <p class="mt-4 text-slate-400">Complete the reset link sent to your email (configure Resend + Better Auth email handlers).</p>
  </div>
</BaseLayout>
