---
import BaseLayout from '@/layouts/BaseLayout.astro';
---

<BaseLayout title="Services — Astro Business" description="Implementation services and productized offerings.">
  <div class="mx-auto max-w-3xl px-4 py-16">
    <h1 class="text-3xl font-semibold text-white">Services</h1>
    <ul class="mt-6 list-disc space-y-2 pl-5 text-slate-400">
      <li>Performance-focused marketing sites on Astro 6</li>
      <li>Headless CMS workflows with Prisma + admin UI</li>
      <li>Stripe subscriptions and digital goods checkout</li>
    </ul>
  </div>
</BaseLayout>
