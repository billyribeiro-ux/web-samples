---
import BaseLayout from '@/layouts/BaseLayout.astro';
---

<BaseLayout title="Forgot password" noindex={true}>
  <div class="mx-auto max-w-xl px-4 py-16 text-center">
    <h1 class="text-3xl font-semibold text-white">Forgot password</h1>
    <p class="mt-4 text-slate-400">
      Use Better Auth&apos;s built-in reset flow via the client SDK or wire `forgotPassword` in your auth config with Resend.
    </p>
  </div>
</BaseLayout>
