---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { searchSite } from '@/lib/search';

const q = Astro.url.searchParams.get('q') ?? '';
const results = q ? await searchSite(q) : { posts: [], products: [], pages: [] };
---

<BaseLayout title="Search" noindex={true}>
  <div class="mx-auto max-w-3xl px-4 py-16">
    <h1 class="text-3xl font-semibold text-white">Search</h1>
    <form method="get" class="mt-6 flex gap-2">
      <label for="q" class="sr-only">
        Query
      </label>
      <input
        id="q"
        name="q"
        value={q}
        placeholder="Search posts, products, pages…"
        class="flex-1 rounded-md border border-slate-700 bg-slate-900 px-3 py-2 text-white"
      />
      <button type="submit" class="rounded-md bg-emerald-500 px-4 py-2 text-sm font-semibold text-slate-950">
        Search
      </button>
    </form>

    {q && (
      <div class="mt-10 space-y-10">
        <section>
          <h2 class="text-lg font-semibold text-white">Posts</h2>
          <ul class="mt-3 space-y-2 text-slate-400">
            {results.posts.length === 0 && <li>No posts found.</li>}
            {results.posts.map((p) => (
              <li>
                <a href={`/blog/${p.slug}`} class="text-emerald-400 hover:underline">
                  {p.title}
                </a>
              </li>
            ))}
          </ul>
        </section>
        <section>
          <h2 class="text-lg font-semibold text-white">Products</h2>
          <ul class="mt-3 space-y-2 text-slate-400">
            {results.products.length === 0 && <li>No products found.</li>}
            {results.products.map((p) => (
              <li>
                <a href={`/products/${p.slug}`} class="text-emerald-400 hover:underline">
                  {p.name}
                </a>
              </li>
            ))}
          </ul>
        </section>
        <section>
          <h2 class="text-lg font-semibold text-white">Pages</h2>
          <ul class="mt-3 space-y-2 text-slate-400">
            {results.pages.length === 0 && <li>No pages found.</li>}
            {results.pages.map((p) => (
              <li>
                <a href={`/${p.slug}`} class="text-emerald-400 hover:underline">
                  {p.title}
                </a>
              </li>
            ))}
          </ul>
        </section>
      </div>
    )}
  </div>
</BaseLayout>
