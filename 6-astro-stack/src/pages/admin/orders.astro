---
import AdminLayout from '@/layouts/AdminLayout.astro';
import { prisma } from '@/lib/prisma';

const orders = await prisma.order.findMany({ orderBy: { createdAt: 'desc' }, take: 50 });
---

<AdminLayout>
  <h1 class="text-2xl font-semibold text-white">Orders</h1>
  <table class="mt-8 w-full text-left text-sm">
    <thead>
      <tr class="border-b border-slate-800 text-slate-500">
        <th class="py-2">ID</th>
        <th class="py-2">Status</th>
        <th class="py-2">Total</th>
      </tr>
    </thead>
    <tbody>
      {orders.map((o) => (
        <tr class="border-b border-slate-800/80">
          <td class="py-3 font-mono text-xs text-slate-400">{o.id.slice(0, 10)}…</td>
          <td class="py-3 text-white">{o.status}</td>
          <td class="py-3 text-slate-400">${(o.total / 100).toFixed(2)}</td>
        </tr>
      ))}
    </tbody>
  </table>
</AdminLayout>
