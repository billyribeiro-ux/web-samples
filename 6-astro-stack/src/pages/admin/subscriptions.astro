---
import AdminLayout from '@/layouts/AdminLayout.astro';
import { prisma } from '@/lib/prisma';

const subs = await prisma.subscription.findMany({
  include: { user: true, plan: true },
  orderBy: { createdAt: 'desc' },
  take: 50,
});
---

<AdminLayout>
  <h1 class="text-2xl font-semibold text-white">Subscriptions</h1>
  <table class="mt-8 w-full text-left text-sm">
    <thead>
      <tr class="border-b border-slate-800 text-slate-500">
        <th class="py-2">User</th>
        <th class="py-2">Plan</th>
        <th class="py-2">Status</th>
      </tr>
    </thead>
    <tbody>
      {subs.map((s) => (
        <tr class="border-b border-slate-800/80">
          <td class="py-3 text-slate-300">{s.user.email}</td>
          <td class="py-3 text-white">{s.plan.name}</td>
          <td class="py-3 text-slate-400">{s.status}</td>
        </tr>
      ))}
    </tbody>
  </table>
</AdminLayout>
