---
import AdminLayout from '@/layouts/AdminLayout.astro';
import { prisma } from '@/lib/prisma';

const assets = await prisma.mediaAsset.findMany({ orderBy: { createdAt: 'desc' }, take: 50 });
---

<AdminLayout>
  <h1 class="text-2xl font-semibold text-white">Media</h1>
  <p class="mt-2 text-sm text-slate-500">Upload via `POST /api/uploads/sign` when S3 env vars are set.</p>
  <ul class="mt-6 space-y-2 text-sm text-slate-400">
    {assets.length === 0 && <li>No assets yet.</li>}
    {assets.map((a) => (
      <li class="truncate">{a.url}</li>
    ))}
  </ul>
</AdminLayout>
