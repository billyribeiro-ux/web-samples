---
import AdminLayout from '@/layouts/AdminLayout.astro';
import { prisma } from '@/lib/prisma';

const users = await prisma.user.findMany({
  orderBy: { createdAt: 'desc' },
  take: 50,
  include: { userRoles: { include: { role: true } } },
});
---

<AdminLayout>
  <h1 class="text-2xl font-semibold text-white">Users</h1>
  <table class="mt-8 w-full text-left text-sm">
    <thead>
      <tr class="border-b border-slate-800 text-slate-500">
        <th class="py-2">Email</th>
        <th class="py-2">Roles</th>
      </tr>
    </thead>
    <tbody>
      {users.map((u) => (
        <tr class="border-b border-slate-800/80">
          <td class="py-3 text-white">{u.email}</td>
          <td class="py-3 text-slate-400">{u.userRoles.map((r) => r.role.slug).join(', ') || '—'}</td>
        </tr>
      ))}
    </tbody>
  </table>
</AdminLayout>
