---
import AdminLayout from '@/layouts/AdminLayout.astro';
---

<AdminLayout>
  <h1 class="text-2xl font-semibold text-white">New post</h1>
  <form method="post" action="/api/admin/posts" class="mt-8 max-w-2xl space-y-4">
    <div>
      <label for="title" class="block text-sm text-slate-400">Title</label>
      <input id="title" name="title" required class="mt-1 w-full rounded border border-slate-700 bg-slate-900 px-3 py-2 text-white" />
    </div>
    <div>
      <label for="slug" class="block text-sm text-slate-400">Slug</label>
      <input id="slug" name="slug" required class="mt-1 w-full rounded border border-slate-700 bg-slate-900 px-3 py-2 text-white" />
    </div>
    <div>
      <label for="excerpt" class="block text-sm text-slate-400">Excerpt</label>
      <textarea id="excerpt" name="excerpt" rows={2} class="mt-1 w-full rounded border border-slate-700 bg-slate-900 px-3 py-2 text-white" />
    </div>
    <div>
      <label for="body" class="block text-sm text-slate-400">Body (HTML)</label>
      <textarea id="body" name="body" required rows={8} class="mt-1 w-full rounded border border-slate-700 bg-slate-900 px-3 py-2 text-white" />
    </div>
    <button type="submit" class="rounded-md bg-emerald-500 px-4 py-2 text-sm font-semibold text-slate-950">Create draft</button>
  </form>
</AdminLayout>
