---
import AdminLayout from '@/layouts/AdminLayout.astro';
import { prisma } from '@/lib/prisma';

const posts = await prisma.post.findMany({ orderBy: { updatedAt: 'desc' }, take: 100 });
---

<AdminLayout>
  <div class="flex items-center justify-between gap-4">
    <h1 class="text-2xl font-semibold text-white">Posts</h1>
    <a
      href="/admin/posts/new"
      class="rounded-md bg-emerald-500 px-3 py-1.5 text-sm font-semibold text-slate-950 hover:bg-emerald-400"
    >
      New post
    </a>
  </div>
  <table class="mt-8 w-full text-left text-sm">
    <thead>
      <tr class="border-b border-slate-800 text-slate-500">
        <th class="py-2">Title</th>
        <th class="py-2">Status</th>
        <th class="py-2">Updated</th>
      </tr>
    </thead>
    <tbody>
      {posts.map((p) => (
        <tr class="border-b border-slate-800/80">
          <td class="py-3 text-white">
            <a href={`/blog/${p.slug}`} class="hover:text-emerald-400">
              {p.title}
            </a>
          </td>
          <td class="py-3 text-slate-400">{p.status}</td>
          <td class="py-3 text-slate-500">{p.updatedAt.toISOString().slice(0, 10)}</td>
        </tr>
      ))}
    </tbody>
  </table>
</AdminLayout>
