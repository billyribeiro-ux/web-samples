---
import BaseLayout from '@/layouts/BaseLayout.astro';
---

<BaseLayout title="FAQ — Astro Business">
  <div class="mx-auto max-w-3xl px-4 py-16">
    <h1 class="text-3xl font-semibold text-white">FAQ</h1>
    <dl class="mt-8 space-y-6 text-slate-400">
      <div>
        <dt class="font-medium text-white">Is this production-ready?</dt>
        <dd class="mt-1">Core flows are real (auth, CMS, Stripe webhooks). Harden TLS, monitoring, and backups for production.</dd>
      </div>
      <div>
        <dt class="font-medium text-white">Where is media stored?</dt>
        <dd class="mt-1">S3-compatible storage via presigned uploads — configure MinIO locally or R2/S3 in production.</dd>
      </div>
    </dl>
  </div>
</BaseLayout>
