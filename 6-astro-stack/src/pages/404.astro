---
import BaseLayout from '@/layouts/BaseLayout.astro';
---

<BaseLayout title="Page not found" noindex={true}>
  <div class="mx-auto max-w-xl px-4 py-24 text-center">
    <p class="text-sm font-medium text-emerald-400/90">404</p>
    <h1 class="mt-2 text-3xl font-semibold text-white">This page does not exist</h1>
    <a href="/" class="mt-8 inline-block text-emerald-400 hover:underline">Back home</a>
  </div>
</BaseLayout>
