---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { prisma } from '@/lib/prisma';

const page = await prisma.page.findUnique({ where: { slug: 'privacy-policy' } });
if (!page) throw new Error('Missing privacy page — run seed');
---

<BaseLayout title={page.seoTitle ?? page.title} description={page.seoDescription ?? undefined}>
  <article class="mx-auto max-w-3xl px-4 py-16">
    <h1 class="text-3xl font-semibold text-white">{page.title}</h1>
    <div class="mt-8 space-y-4 text-slate-300" set:html={page.body} />
  </article>
</BaseLayout>
