---
import Layout from "../../layouts/Layout.astro";
import { apiServerFetch } from "../../lib/api";

const { slug } = Astro.params;
if (!slug) return Astro.redirect("/404");
const res = await apiServerFetch(Astro.request, `/v1/public/tags/${slug}`);
if (!res.ok) return Astro.redirect("/404");
const { tag } = (await res.json()) as {
  tag: { name: string; posts: { post: { slug: string; title: string; excerpt: string | null } }[] };
};
---
<Layout title={`Tag: ${tag.name}`} description={`Posts tagged ${tag.name}`}>
  <h1 class="text-3xl font-semibold">#{tag.name}</h1>
  <ul class="mt-8 space-y-4">
    {tag.posts.map(({ post }) => (
      <li>
        <a class="font-semibold text-accent hover:underline" href={`/blog/${post.slug}`}>{post.title}</a>
        {post.excerpt && <p class="text-sm text-slate-600">{post.excerpt}</p>}
      </li>
    ))}
  </ul>
</Layout>
