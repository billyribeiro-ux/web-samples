---
import Layout from "../layouts/Layout.astro";
import { apiUrl } from "../lib/api";

const url = apiUrl("/v1/auth/reset-password");
const token = Astro.url.searchParams.get("token") ?? "";
---
<Layout title="Reset password" description="Choose a new password">
  <h1 class="text-3xl font-semibold">Reset password</h1>
  <form id="rp" class="mt-8 max-w-md space-y-4">
    <input type="hidden" id="token" value={token} />
    <input class="w-full rounded-md border px-3 py-2 text-sm" id="password" type="password" minlength="8" placeholder="New password" required />
    <p id="st" class="text-sm text-slate-600" />
    <button class="rounded-md bg-accent px-4 py-2 text-sm font-semibold text-white" type="submit">Update password</button>
  </form>
  <script define:vars={{ url }}>
    document.getElementById("rp")?.addEventListener("submit", async (e) => {
      e.preventDefault();
      const password = (document.getElementById("password") as HTMLInputElement).value;
      const tok = (document.getElementById("token") as HTMLInputElement).value;
      const res = await fetch(url, {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ token: tok, password }),
      });
      document.getElementById("st").textContent = res.ok ? "Password updated. You can sign in." : "Invalid or expired token.";
    });
  </script>
</Layout>
