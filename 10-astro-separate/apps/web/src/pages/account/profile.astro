---
import Layout from "../../layouts/Layout.astro";
import { apiServerFetch } from "../../lib/api";

const res = await apiServerFetch(Astro.request, "/v1/account/me");
if (res.status === 401) return Astro.redirect("/login");
const { user } = (await res.json()) as { user: { name: string | null; email: string } };
---
<Layout title="Profile" description="Profile settings">
  <h1 class="text-2xl font-semibold">Profile</h1>
  <p class="mt-2 text-sm text-slate-600">{user.email}</p>
</Layout>
