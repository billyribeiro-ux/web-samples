---
import Layout from "../layouts/Layout.astro";
import { getPage } from "../lib/content";

const page = await getPage(Astro.request, "faq");
if (!page) return Astro.redirect("/404");
---
<Layout title={page.title} description="Frequently asked questions.">
  <article class="prose prose-slate max-w-none">
    <h1>{page.title}</h1>
    <div class="whitespace-pre-wrap text-slate-700">{page.body}</div>
  </article>
</Layout>
