---
import Layout from "../layouts/Layout.astro";
import { apiServerFetch } from "../lib/api";

const res = await apiServerFetch(Astro.request, "/v1/public/products");
const { products } = res.ok
  ? ((await res.json()) as {
      products: { name: string; slug: string; description: string | null; priceCents: number; currency: string }[];
    })
  : { products: [] };
---
<Layout title="Services & products" description="Digital products and services from Nimbus.">
  <h1 class="text-3xl font-semibold text-ink">Services & products</h1>
  <p class="mt-3 max-w-2xl text-slate-600">Commerce-ready listings backed by the shared API and admin catalog.</p>
  <div class="mt-10 grid gap-6 md:grid-cols-2">
    {products.map((p) => (
      <a
        href={`/products/${p.slug}`}
        class="rounded-xl border border-slate-200 bg-white p-6 shadow-sm transition hover:border-accent/40 hover:shadow-md"
      >
        <h2 class="text-lg font-semibold text-ink">{p.name}</h2>
        {p.description && <p class="mt-2 text-sm text-slate-600">{p.description}</p>}
        <p class="mt-4 text-sm font-semibold text-accent">
          {(p.priceCents / 100).toFixed(2)} {p.currency.toUpperCase()}
        </p>
      </a>
    ))}
  </div>
</Layout>
