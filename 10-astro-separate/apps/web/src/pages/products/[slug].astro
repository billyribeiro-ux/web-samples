---
import Layout from "../../layouts/Layout.astro";
import { apiServerFetch } from "../../lib/api";

const { slug } = Astro.params;
if (!slug) return Astro.redirect("/404");

const res = await apiServerFetch(Astro.request, `/v1/public/products/${slug}`);
if (!res.ok) return Astro.redirect("/404");
const { product } = (await res.json()) as {
  product: { name: string; description: string | null; body: string | null; priceCents: number; currency: string };
};
---
<Layout title={product.name} description={product.description ?? product.name}>
  <article>
    <h1 class="text-3xl font-semibold text-ink">{product.name}</h1>
    {product.description && <p class="mt-3 text-lg text-slate-600">{product.description}</p>}
    <p class="mt-6 text-2xl font-semibold text-accent">
      {(product.priceCents / 100).toFixed(2)} {product.currency.toUpperCase()}
    </p>
    {product.body && <div class="prose prose-slate mt-10 max-w-none whitespace-pre-wrap">{product.body}</div>}
  </article>
</Layout>
