---
import Layout from "../layouts/Layout.astro";
import { apiUrl } from "../lib/api";

const url = apiUrl("/v1/auth/forgot-password");
---
<Layout title="Forgot password" description="Reset your password">
  <h1 class="text-3xl font-semibold">Forgot password</h1>
  <form id="fp" class="mt-8 max-w-md space-y-4">
    <input class="w-full rounded-md border px-3 py-2 text-sm" id="email" type="email" placeholder="Email" required />
    <p id="st" class="text-sm text-slate-600" />
    <button class="rounded-md bg-accent px-4 py-2 text-sm font-semibold text-white" type="submit">Send reset link</button>
  </form>
  <script define:vars={{ url }}>
    document.getElementById("fp")?.addEventListener("submit", async (e) => {
      e.preventDefault();
      const email = (document.getElementById("email") as HTMLInputElement).value;
      await fetch(url, { method: "POST", headers: { "Content-Type": "application/json" }, body: JSON.stringify({ email }) });
      document.getElementById("st").textContent = "If the email exists, a reset link was sent.";
    });
  </script>
</Layout>
