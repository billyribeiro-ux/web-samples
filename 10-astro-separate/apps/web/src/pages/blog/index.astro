---
import Layout from "../../layouts/Layout.astro";
import { apiServerFetch } from "../../lib/api";

const res = await apiServerFetch(Astro.request, "/v1/public/posts?take=30");
const { posts } = res.ok
  ? ((await res.json()) as {
      posts: { slug: string; title: string; excerpt: string | null; publishedAt: string | null; readingMinutes: number | null }[];
    })
  : { posts: [] };
---
<Layout title="Blog" description="Articles on growth, engineering, and product.">
  <h1 class="text-3xl font-semibold text-ink">Blog</h1>
  <p class="mt-3 text-slate-600">Published posts from the headless CMS.</p>
  <ul class="mt-10 space-y-6">
    {posts.map((post) => (
      <li class="rounded-xl border border-slate-200 bg-white p-6 shadow-sm">
        <a class="text-xl font-semibold text-ink hover:text-accent" href={`/blog/${post.slug}`}>{post.title}</a>
        {post.excerpt && <p class="mt-2 text-sm text-slate-600">{post.excerpt}</p>}
        <p class="mt-3 text-xs text-slate-500">
          {post.publishedAt ? new Date(post.publishedAt).toLocaleDateString() : ""}
          {post.readingMinutes ? ` · ${post.readingMinutes} min read` : ""}
        </p>
      </li>
    ))}
  </ul>
</Layout>
