---
import { apiServerFetch } from "../lib/api";

const res = await apiServerFetch(Astro.request, "/v1/public/navigation/FOOTER");
const data = res.ok
  ? ((await res.json()) as { menu?: { items: { label: string; href: string }[] } })
  : { menu: undefined };
const items = data.menu?.items ?? [
  { label: "Privacy", href: "/privacy-policy" },
  { label: "Terms", href: "/terms" },
  { label: "Cookies", href: "/cookies" },
];
---
<footer class="mt-20 border-t border-slate-200 bg-mist">
  <div class="mx-auto flex max-w-6xl flex-col gap-6 px-4 py-12 md:flex-row md:items-center md:justify-between">
    <p class="text-sm text-slate-600">© {new Date().getFullYear()} Nimbus Platform. Sample product.</p>
    <nav class="flex flex-wrap gap-4 text-sm text-slate-700" aria-label="Footer">
      {items.map((i) => (
        <a class="hover:text-accent" href={i.href}>{i.label}</a>
      ))}
    </nav>
  </div>
</footer>
