---
import { apiServerFetch } from "../lib/api";

const res = await apiServerFetch(Astro.request, "/v1/public/navigation/HEADER");
const data = res.ok
  ? ((await res.json()) as { menu?: { items: { label: string; href: string }[] } })
  : { menu: undefined };
const items = data.menu?.items ?? [
  { label: "Services", href: "/services" },
  { label: "Pricing", href: "/pricing" },
  { label: "Blog", href: "/blog" },
  { label: "Contact", href: "/contact" },
];
---
<header class="border-b border-slate-200 bg-white/80 backdrop-blur">
  <div class="mx-auto flex max-w-6xl items-center justify-between gap-6 px-4 py-4">
    <a href="/" class="text-lg font-semibold tracking-tight text-ink">Nimbus</a>
    <nav class="hidden items-center gap-6 text-sm font-medium text-slate-700 md:flex" aria-label="Primary">
      {items.map((i) => (
        <a class="hover:text-accent" href={i.href}>{i.label}</a>
      ))}
    </nav>
    <div class="flex items-center gap-3 text-sm">
      <a class="rounded-md px-3 py-2 text-slate-700 hover:bg-slate-100" href="/search">Search</a>
      <a class="rounded-md px-3 py-2 text-slate-700 hover:bg-slate-100" href="/cart">Cart</a>
      <a class="rounded-md px-3 py-2 text-slate-700 hover:bg-slate-100" href="/login">Log in</a>
      <a
        class="rounded-md bg-accent px-3 py-2 font-semibold text-white shadow-sm hover:bg-blue-600"
        href="/register">Join</a>
    </div>
  </div>
</header>
