# Database
DATABASE_URL="postgresql://platform:platform@localhost:5433/platform"

# API (Hono) — port 3001 in dev
API_PORT=3001
SESSION_SECRET="change-me-to-a-long-random-string-in-production"
MEMBER_SESSION_COOKIE_NAME=platform_member_session
ADMIN_SESSION_COOKIE_NAME=platform_admin_session

# Public URLs (browser + SSR)
PUBLIC_SITE_URL=http://localhost:4321
PUBLIC_ADMIN_URL=http://localhost:5173
PUBLIC_API_URL=http://localhost:3001

# Admin (Vite)
VITE_PUBLIC_API_URL=http://localhost:3001

# Server-to-server (Astro SSR calling API without cookies — optional)
INTERNAL_API_SECRET=

# Stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PUBLISHABLE_KEY=

# Resend
RESEND_API_KEY=
RESEND_FROM_EMAIL=noreply@example.com

# S3-compatible (AWS or R2)
S3_ENDPOINT=
S3_REGION=us-east-1
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_BASE_URL=

# Analytics (optional)
PUBLIC_POSTHOG_KEY=
PUBLIC_GA4_MEASUREMENT_ID=
